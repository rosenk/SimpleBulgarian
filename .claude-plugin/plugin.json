{
  "name": "simple-bulgarian",
  "displayName": "Simple Bulgarian",
  "description": "Пишете прост, ясен български текст по образеца на ASD-STE100 Simplified Technical English: кратки изречения, една дума за едно значение, деятелен залог, условие преди команда, определение на всеки термин при първа употреба, без канцеларщина.",
  "version": "0.1.2",
  "license": "MIT",
  "keywords": [
    "technical-writing",
    "documentation",
    "bulgarian",
    "plain-language",
    "ste",
    "asd-ste100"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/simple-bulgarian-activate.js\"",
            "timeout": 5,
            "statusMessage": "Зареждане на Simple Bulgarian..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/hooks/lint_hook.py\"",
            "timeout": 10,
            "statusMessage": "Simple Bulgarian: проверка на файла..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/hooks/lint_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
